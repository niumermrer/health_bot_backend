<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.chatbot.mapper.AddressMapper">


    <select id="selectByUid" resultType="com.chatbot.pojo.Address">
        select * from address where UID = #{uid}
    </select>
    <select id="selectByAddressId" resultType="com.chatbot.pojo.Address">
        select * from address where ADDRESSID = #{addressId}
    </select>
</mapper>
